      "verification_policy_ref": "verification-policy:repair-diagnosis@1",
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": []
      },
      "approval": {
        "mode": "before_stage",
        "policy_ref": "approval-policy:repair-handoff-replan@1"
      },
      "handoff": {
        "mode": "local_changes",
        "required": true,
        "project_override_modes": [
          "local_changes"
        ]
      }
    }
  ]
}
