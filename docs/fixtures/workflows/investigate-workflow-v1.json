{
  "schema_version": "xuanwu.workflow-manifest.v1",
  "id": "workflow:investigate",
  "revision": 1,
  "name": "Investigate",
  "description": "Read-only scoping, reproduction, root-cause analysis, Evidence collection, and bounded handoff reporting.",
  "stages": [
    {
      "id": "scope",
      "name": "Scope the investigation",
      "agent": {
        "role": "reporter",
        "required_skill_ids": []
      },
      "permissions": {
        "max_tool_permission": "read",
        "allowed_tools": [
          "runner-builtin:project_status",
          "runner-builtin:work_read",
          "runner-builtin:run_read",
          "runner-builtin:issue_read",
          "runner-builtin:issue_execution_status",
          "runner-builtin:session_read_summary"
        ],
        "allowed_actions": []
      },
      "verification_policy_ref": "verification-policy:investigate-read-only@1",
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": []
      },
      "approval": {
        "mode": "none"
      },
      "handoff": {
        "mode": "local_changes",
        "project_override_modes": [
          "local_changes"
        ]
      }
    },
    {
      "id": "reproduce",
      "name": "Reproduce without mutation",
      "agent": {
        "role": "executor",
        "required_skill_ids": []
      },
      "permissions": {
        "max_tool_permission": "read",
        "allowed_tools": [
          "runner-builtin:read",
          "runner-builtin:grep",
          "runner-builtin:find",
          "runner-builtin:ls",
          "runner-builtin:repo_tree",
          "runner-builtin:repo_search",
          "runner-builtin:repo_read_excerpt",
          "http-readonly:url_fetch",
          "browser-readonly:read_page_context"
        ],
        "allowed_actions": []
      },
      "verification_policy_ref": "verification-policy:investigate-read-only@1",
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": []
      },
      "approval": {
        "mode": "none"
      },
      "handoff": {
        "mode": "local_changes",
        "project_override_modes": [
          "local_changes"
        ]
      }
    },
    {
      "id": "root-cause",
      "name": "Establish the root cause",
      "agent": {
        "role": "executor",
        "required_skill_ids": []
      },
      "permissions": {
        "max_tool_permission": "read",
        "allowed_tools": [
          "runner-builtin:read",
          "runner-builtin:grep",
          "runner-builtin:find",
          "runner-builtin:ls",
          "runner-builtin:repo_tree",
          "runner-builtin:repo_search",
          "runner-builtin:repo_read_excerpt",
          "runner-builtin:work_read",
          "runner-builtin:run_read",
          "runner-builtin:issue_read",
          "runner-builtin:issue_execution_status",
          "runner-builtin:session_read_summary",
          "http-readonly:url_fetch",
          "browser-readonly:read_page_context"
        ],
        "allowed_actions": []
      },
      "verification_policy_ref": "verification-policy:investigate-read-only@1",
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": []
      },
      "approval": {
        "mode": "none"
      },
      "handoff": {
        "mode": "local_changes",
        "project_override_modes": [
          "local_changes"
        ]
      }
    },
    {
      "id": "report",
      "name": "Produce the handoff report",
      "agent": {
        "role": "reporter",
        "required_skill_ids": []
      },
      "permissions": {
        "max_tool_permission": "read",
        "allowed_tools": [
          "runner-builtin:work_read",
          "runner-builtin:run_read"
        ],
        "allowed_actions": []
      },
      "verification_policy_ref": "verification-policy:investigate-read-only@1",
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": []
      },
      "approval": {
        "mode": "none"
      },
      "handoff": {
        "mode": "local_changes",
        "project_override_modes": [
          "local_changes"
        ]
      }
    }
  ]
}
